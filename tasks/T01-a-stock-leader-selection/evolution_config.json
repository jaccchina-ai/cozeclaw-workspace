    },
    
    "selection_method": "tournament",   # 选择方法: roulette/tournament/rank
    "tournament_size": 3,               # 锦标赛规模
    
    "backtest_days": 60,                # 回测天数
    "lookback_period": 20,              # 回溯周期
    
    "early_stopping": true,             # 是否启用早停
    "patience": 20,                     # 早停耐心值
    "min_improvement": 0.001,           # 最小提升阈值
    
    "factor_weights_range": {
      "limit_quality": [0.05, 0.2],     # 涨停质量因子权重范围
      "seal_ratio": [0.05, 0.15],       # 封成比因子权重范围
      "seal_flow_ratio": [0.05, 0.15],  # 封流比因子权重范围
      "volume_ratio": [0.05, 0.15],     # 量比因子权重范围
      "turnover_rate": [0.05, 0.15],    # 换手率因子权重范围
