    "metrics_to_monitor": [
      "win_rate",
      "avg_return",
      "max_drawdown",
      "profit_factor",
      "sharpe_ratio",
      "sortino_ratio",
      "win_loss_ratio"
    ],
    
    "visualization": {
      "enabled": true,                  # 是否启用可视化
