      "amount_rank": [0.05, 0.1],       # 成交额排名因子权重范围
      "sector_heat": [0.05, 0.15],      # 板块热度因子权重范围
      "bias_ma3": [0.05, 0.15],         # MA3乖离率因子权重范围
      "sentiment": [0.02, 0.1]          # 舆情因子权重范围
    }
  },
  
  "result_analysis": {
    "top_n": 5,                         # 显示前N个最佳策略
